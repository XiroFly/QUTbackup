{"ast":null,"code":"import { useStore } from 'vuex';\nimport { ref } from 'vue';\nexport default {\n  __name: 'FooterPlayer',\n  setup(__props, {\n    expose\n  }) {\n    expose();\n    const store = useStore();\n    const state = store._state.data; //注意名字\n    // console.log(store._mutations)\n    // console.log(state)\n    const pause = store._mutations.updateIsShowPause[0]; //选项加_，函数在数组里\n    const updatePlayListIndex = store._mutations.updatePlayListIndex[0];\n    const audio = ref();\n    console.log(audio);\n    function play() {\n      if (audio.value.paused) {\n        audio.value.play();\n        console.log(audio.value);\n        console.log(audio.value.play);\n        pause(audio.value.paused);\n      } else {\n        audio.value.pause();\n        pause(audio.value.paused);\n      }\n    }\n    const date = ref(0);\n    function fun() {\n      console.log('aas');\n    }\n    function switchMusic(e) {\n      date.value = e.changedTouches[0].clientX - date.value;\n      if (date.value > 80) {\n        //上一首\n        if (state.playListIndex == 0) {\n          updatePlayListIndex(state.playList.length - 1);\n        } else {\n          updatePlayListIndex(state.playListIndex - 1);\n        }\n      }\n      if (date.value < -80) {\n        //下一首\n        updatePlayListIndex((state.playListIndex + 1) % state.playList.length);\n      }\n    }\n    const __returned__ = {\n      store,\n      state,\n      pause,\n      updatePlayListIndex,\n      audio,\n      play,\n      date,\n      fun,\n      switchMusic,\n      get useStore() {\n        return useStore;\n      },\n      ref\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"mappings":"AA8BA,SAASA,QAAQ,QAAQ,MAAM;AAC/B,SAASC,GAAG,QAAQ,KAAK;;;;;;;IACzB,MAAMC,KAAK,GAACF,QAAQ,EAAE;IACtB,MAAMG,KAAK,GAAGD,KAAK,CAACE,MAAM,CAACC,IAAI,CAAC;IAChC;IACA;IACA,MAAMC,KAAK,GAACJ,KAAK,CAACK,UAAU,