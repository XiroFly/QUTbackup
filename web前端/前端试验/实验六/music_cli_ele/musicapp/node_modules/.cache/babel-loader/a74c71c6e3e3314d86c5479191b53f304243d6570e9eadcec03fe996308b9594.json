{"ast":null,"code":"import { useStore } from 'vuex';\nimport { ref, onUpdated, onMounted } from 'vue';\nimport MusicDetial from '@/components/MusicDetial.vue';\nexport default {\n  __name: 'FooterPlayer',\n  setup(__props, {\n    expose\n  }) {\n    expose();\n    const store = useStore();\n    const state = store._state.data; //注意名字\n    // console.log(store._mutations)\n\n    const pause = store._mutations.updateIsShowPause[0]; //选项加_，函数在数组里\n    const updatePlayListIndex = store._mutations.updatePlayListIndex[0];\n    const audio = ref();\n    console.log(audio);\n    let interval; //计时器\n    function updateTime() {\n      interval = setInterval(() => {\n        console.log(audio._value.currentTime);\n        // store._mutations.updateCurrentTime[0](audio.value.currentTime)\n      }, 1000);\n    }\n    function play() {\n      if (audio.value.paused) {\n        audio.value.play();\n        console.log(audio.value);\n        pause(audio.value.paused);\n        updateTime();\n      } else {\n        audio.value.pause();\n        pause(audio.value.paused);\n        clearInterval(interval);\n      }\n    }\n    const date = ref(0);\n    function switchMusic(e) {\n      console.log('aa');\n      date.value = e.changedTouches[0].clientX - date.value;\n      if (date.value > 80) {\n        //上一首\n        if (state.playListIndex == 0) {\n          updatePlayListIndex(state.playList.length - 1);\n        } else {\n          updatePlayListIndex(state.playListIndex - 1);\n        }\n      }\n      if (date.value < -80) {\n        //下一首\n        updatePlayListIndex((state.playListIndex + 1) % state.playList.length);\n      }\n    }\n    const show = ref(false);\n    function toMusicDetial() {\n      show.value = true;\n    }\n    onMounted(() => {\n      store.dispatch('getLyric', state.playList[state.playListIndex].id);\n    });\n    onUpdated(() => {\n      store.dispatch('getLyric', state.playList[state.playListIndex].id);\n    });\n    const __returned__ = {\n      store,\n      state,\n      pause,\n      updatePlayListIndex,\n      audio,\n      get interval() {\n        return interval;\n      },\n      set interval(v) {\n        interval = v;\n      },\n      updateTime,\n      play,\n      date,\n      switchMusic,\n      show,\n      toMusicDetial,\n      get useStore() {\n        return useStore;\n      },\n      ref,\n      onUpdated,\n      onMounted,\n      MusicDetial\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"mappings":"AA6CA,SAASA,QAAQ,QAAQ,MAAM;AAC/B,SAASC,GAAG,EAACC,SAAS,EAACC,SAAS,QAAQ,KAAK;AAC7C,OAAOC,WAAW,MAAM,8BAA8B;;;;;;;IAEtD,MAAMC,KAAK,GAACL,QAAQ,EAAE;IACtB,MAAMM,KAAK,GAAGD,KAAK,CAACE,MAAM,CAACC,IAAI,CAAC;IAChC;;IAEA,MAAMC,KAAK,GAACJ,KAAK,CAACK,UAAU,CAACC,iBAAiB,CAAC,CAAC,CAAC,CAAC;IAClD,MAAQC,mBAAmB,GAACP,KAAK,CAACK,UAAU,CAACE,mBAAmB,CAAC,CAAC,CAAC;IACnE,MAAMC,KAAK,GAACZ,GAAG,EAAE;IACjBa,OAAO,CAACC,GAAG,CAACF,KAAK,CAAC;IAClB,IAAIG,QAAQ,CAAC;IACb,SAASC,UAAU,GAAE;MACnBD,QAAQ,GAAGE,WAAW,CAAC,MAAI;QACzBJ,OAAO,CAACC,GAAG,CAACF,KAAK,CAACM,MAAM,CAACC,WAAW,CAAC;QAClC;MAEH,CAAC,EAAC,IAAI,CAAC;IACX;IACA,SAASC,IAAI,GAAE;MACX,IAAGR,KAAK,CAACS,KAAK,CAACC,MAAM,EACrB;QAACV,KAAK,CAACS,KAAK,CAACD,IAAI,EAAE;QACfP,OAAO,CAACC,GAAG,CAACF,KAAK,CAACS,KAAK,CAAC;QAC5Bb,KAAK,CAACI,KAAK,CAACS,KAAK,CAACC,MAAM,CAAC;QACzBN,UAAU,EAAE;MAChB,CAAC,MACQ;QACDJ,KAAK,CAACS,KAAK,CAACb,KAAK,EAAE;QACnBA,KAAK,CAACI,KAAK,CAACS,KAAK,CAACC,MAAM,CAAC;QACzBC,aAAa,CAACR,QAAQ,CAAC;MAC3B;IACJ;IACA,MAAMS,IAAI,GAACxB,GAAG,CAAC,CAAC,CAAC;IACjB,SAASyB,WAAW,CAACC,CAAC,EAAC;MACnBb,OAAO,CAACC,GAAG,CAAC,IAAI,CAAC;MACjBU,IAAI,CAACH,KAAK,GAACK,CAAC,CAACC,cAAc,CAAC,CAAC,CAAC,CAACC,OAAO,GAACJ,IAAI,CAACH,KAAK;MACjD,IAAGG,IAAI,CAACH,KAAK,GAAC,EAAE,EAAC;QAClB;QACC,IAAGhB,KAAK,CAACwB,aAAa,IAAE,CAAC,EAAC;UAAClB,mBAAmB,CAACN,KAAK,CAACyB,QAAQ,CAACC,MAAM,GAAC,CAAC,CAAC;QAAA,CAAC,MAEpE;UAACpB,mBAAmB,CAACN,KAAK,CAACwB,aAAa,GAAC,CAAC,CAAC;QAAC;MA