{"ast":null,"code":"import { ref, computed, watch } from 'vue';\nexport default {\n  __name: 'MusicDetial',\n  props: ['music', 'isShowPaused', 'lyric', 'currentTime'],\n  setup(__props, {\n    expose\n  }) {\n    expose();\n    const props = __props;\n    const showShare = ref(false);\n    const options = [{\n      name: '微信',\n      icon: 'wechat'\n    }, {\n      name: '微博',\n      icon: 'weibo'\n    }, {\n      name: '复制链接',\n      icon: 'link'\n    }, {\n      name: '分享海报',\n      icon: 'poster'\n    }, {\n      name: '二维码',\n      icon: 'qrcode'\n    }];\n    const onSelect = option => {\n      showToast(option.name);\n      showShare.value = false;\n    };\n    const Lyric = computed(() => {\n      let arr;\n      if (props.lyric.lyric) {\n        arr = props.lyric.lyric.split(/[(\\r\\n)\\r\\n]+/).map((item, i) => {\n          let min = item.slice(item.indexOf('[') + 1, item.indexOf(':'));\n          let sec = item.slice(item.indexOf(':') + 1, item.indexOf('.'));\n          let mill = item.slice(item.indexOf('.') + 1, item.indexOf(']'));\n          let lrc = item.slice(item.indexOf(']') + 1, item.length);\n          let time = parseInt(min) * 60 * 1000 + parseInt(sec) * 1000 + parseInt(mill);\n          return {\n            min,\n            sec,\n            mill,\n            lrc,\n            time\n          };\n        });\n      }\n      arr.forEach((item, i) => {\n        if (i === arr.length - 1) {\n          item.pre = 0;\n        } else {\n          item.pre = arr[i + 1].time;\n        }\n      });\n      return arr;\n    });\n    const musicLyric = ref();\n    watch(musicLyric, () => {\n      console.log('22222');\n      let p = document.querySelector(\"p.active\");\n      console.log(p.offsetTop); //加括号看到引用\n      console.log(musicLyric);\n      if (p && p.offsetTop > 600) {\n        musicLyric._value.offsetTop = p.offsetTop - 50;\n      }\n    });\n    const __returned__ = {\n      props,\n      showShare,\n      options,\n      onSelect,\n      Lyric,\n      musicLyric,\n      ref,\n      computed,\n      watch\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"mappings":"AAsDA,SAASA,GAAG,EAAEC,QAAQ,EAACC,KAAK,QAAO,KAAK;;;;;;;;;IAExC,MAAMC,SAAS,GAAGH,GAAG,CAAC,KAAK,CAAC;IACxB,MAAMI,OAAO,GAAG,CACd;MAAEC,IAAI,EAAE,IAAI;MAAEC,IAAI,EAAE;IAAS,CAAC,EAC9B;MAAED,IAAI,EAAE,IAAI;MAAEC,IAAI,EAAE;IAAQ,CAAC,EAC7B;MAAED,IAAI,EAAE,MAAM;MAAEC,IAAI,EAAE;IAAO,CAAC,EAC9B;MAAED,IAAI,EAAE,MAAM;MAAEC,IAAI,EAAE;IAAS,CAAC,EAChC;MAAED,IAAI,EAAE,KAAK;MAAEC,IAAI,EAAE;IAAS,CAAC,CAChC;IACD,MAAMC,QAAQ,GAAIC,MAAM,IAAK;MAC3BC,SAAS,CAACD,MAAM,CAACH,IAAI,CAAC;MACtBF,SAAS,CAACO,KAAK,GAAG,KAAK;IACzB,CAAC;IAEL,MAAMC,KAAK,GAACV,QAAQ,CAAC,MAAI;MACvB,IAAIW,GAAG;MACN,IAAGC,KAAK,CAACC,KAAK,CAACA,KAAK,EAAC;QACpBF,GAAG,GAACC,KAAK,CAACC,KAAK,CAACA,KAAK,CAACC,KAAK,CAAC,eAAe,CAAC,CAACC,GAAG,CAAC,CAACC,IAAI,EAACC,CAAC,KAAG;UACzD,IAAIC,GAAG,GAACF,IAAI,CAACG,KAAK,CAACH,IAAI,CAACI,OAAO,CAAC,GAAG,CAAC,GAAC,CAAC,EAACJ,IAAI,CAACI,OAAO,CAAC,GAAG,CAAC,CAAC;UACzD,IAAIC,GAAG,GAACL,IAAI,CAACG,KAAK,CAACH,IAAI,CAACI,OAAO,CAAC,GAAG,CAAC,GAAC,CAAC,EAACJ,IAAI,CAACI,OAAO,CAAC,GAAG,CAAC,CAAC;UACzD,IAAIE,IAAI,GAACN,IAAI,CAACG,KAAK,CAACH,IAAI,CAACI,OAAO,CAAC,GAAG,CAAC,GAAC,CAAC,EAACJ,IAAI,CAACI,OAAO,CAAC,GAAG,CAAC,CAAC;UAC1D,IAAIG,GAAG,GAACP,IAAI,CAACG,KAAK,CAACH,IAAI,CAACI,OAAO,CAAC,GAAG,CAAC,GAAC,CAAC,EAACJ,IAAI,CAACQ,MAAM,CAAC;UACnD,IAAIC,IAAI,GAACC,QAAQ,CAACR,GAAG,CAAC,GAAC,EAAE,GAAC,IAAI,GAACQ,QAAQ,CAACL,GAAG,CAAC,GAAC,IAAI,GAACK,QAAQ,CAACJ,IAAI,CAAC;UAChE,OAAO;YAACJ,GAAG;YAACG,GAAG;YAACC,IAAI;YAACC,GAAG;YAACE;UAAI,CAAC;QAChC,CAAC,CAAC;MACH;MACAd,GAAG,CAACgB,OAAO,CAAC,CAACX,IAAI,EAACC,CAAC,KAAK;QACvB,IAAGA,CAAC,KAAGN,GAAG,CAACa,MAAM,GAAC,CAAC,EAAC;UAClBR,IAAI,CAACY,GAAG,GAAC,CAAC;QACZ,CAAC,MACG;UACFZ,IAAI,CAACY,GAAG,GAACjB,GAAG,CAACM,CAAC,GAAC,CAAC,CAAC,CAACQ,IAAI;QACxB;MACD,CAAC,CAAC;MACF,OAAOd,GAAG;IACb,CAAC,CAAC;IACF,MAAMkB,UAAU,GAAC9B,GAAG,EAAE;IACtBE,KAAK,CAAC4B,UAAU,EAAC,MAAI;MACnBC,OAAO,CAACC,GAAG,CAAC,OAAO,CAAC;MACpB,IAAIC,CAAC,GAACC,QAAQ,CAACC,aAAa,CAAC,UAAU,CAAC;MACxCJ,OAAO,CAACC,GAAG,CAACC,CAAC,CAACG,SAAS,CAAC,CAAC;MACzBL,OAAO,CAACC,GAAG,CAACF,UAAU,CAAC;MACxB,IAAGG,CAAC,IAAEA,CAAC,CAACG,SAAS,GAAC,GAAG,EAAC;QACrBN,UAAU,CAACO,MAAM,CAACD,SAAS,GAACH,CAAC,CAACG,SAAS,GAAC,EAAE;MAC3C;IAEA,CAAC,CAAC","names":["ref","computed","watch","showShare","options","name","icon","onSelect","option","showToast","value","Lyric","arr","props","lyric","split","map","item","i","min","slice","indexOf","sec","mill","lrc","length","time","parseInt","forEach","pre","musicLyric","console","log","p","document","querySelector","offsetTop","_value"],"sources":["D:/Users/fly/Vue/music_cli_ele/musicapp/src/components/MusicDetial.vue"],"sourcesContent":["<template>\r\n  <img :src=\"props.music.al.picUrl\" class=\"bgimg\" alt=\"\"/>\r\n <div class=\"top\">\r\n    <div class=\"topleft\">\r\n        <svg class=\"icon\" aria-hidden=\"true\"  @click=\"$emit('close')\" >\r\n      <use  xlink:href=\"#icon-zuojiantou\"></use>\r\n      </svg>\r\n      <div class=\"name\">     \r\n        <div class=\"a\"><marquee>{{ props.music.name }}</marquee></div>\r\n        <div class=\"b\">\r\n        <span v-for=\"item of props.music.ar\" :key=\"item\">{{ item.name }}</span>\r\n        <svg class=\"icon\" aria-hidden=\"true\"  >\r\n      <use  xlink:href=\"#icon-youjiantou\"></use>\r\n      </svg>\r\n    </div> \r\n    </div>\r\n     \r\n    </div>\r\n    <div class=\"topright\">\r\n        <svg class=\"icon\" aria-hidden=\"true\"   @click=\"showShare = true\" >\r\n      <use  xlink:href=\"#icon-fenxiang\"></use>\r\n      </svg>\r\n    </div>  \r\n </div>\r\n <div class=\"content\">\r\n <img src=\"@/assets/磁针.png\" alt=\"\" :class=\"(props.isShowPaused == false?'img_cizhen_active':'img_cizhen')\"/>\r\n <img src=\"@/assets/cycle.png\" alt=\"\" class=\"img_cycle\"/>\r\n <img :src=\"props.music.al.picUrl\" alt=\"\" class=\"pic\" :class=\"(props.isShowPaused == false?'pic_active':'pic_paused')\"/>\r\n </div>\r\n <!--歌词-->\r\n <div class=\"lyric\" ref=\"musicLyric\">\r\n  <p v-for=\"item in Lyric\" :key=\"item\" :class=\"(props.currentTime*1000>=item.time&&props.currentTime*1000<item.pre?'active':'')\">{{item.lrc}}</p>\r\n\r\n\r\n\r\n\r\n </div>\r\n <!--播放按钮-->\r\n<div class=\"play\">\r\n  <svg class=\"icon\" aria-hidden=\"true\" v-if=\"props.isShowPaused\" @click=\"$emit('changePlay')\" >\r\n      <use  xlink:href=\"#icon-24gf-play\"></use>\r\n      </svg>\r\n      <svg class=\"icon\" aria-hidden=\"true\" v-else @click=\"$emit('changePlay')\" >\r\n      <use  xlink:href=\"#icon-24gf-pause2\"></use>\r\n      </svg>\r\n</div>\r\n <van-share-sheet\r\n  v-model:show=\"showShare\"\r\n  title=\"立即分享给好友\"\r\n  :options=\"options\"\r\n  @select=\"onSelect\"\r\n/>\r\n</template>\r\n<script setup>\r\nimport { ref ,computed,watch} from 'vue';\r\nconst props= defineProps(['music','isShowPaused','lyric','currentTime'])\r\nconst showShare = ref(false);\r\n    const options = [\r\n      { name: '微信', icon: 'wechat' },\r\n      { name: '微博', icon: 'weibo' },\r\n      { name: '复制链接', icon: 'link' },\r\n      { name: '分享海报', icon: 'poster' },\r\n      { name: '二维码', icon: 'qrcode' },\r\n    ];\r\n    const onSelect = (option) => {\r\n      showToast(option.name);\r\n      showShare.value = false;\r\n    };\r\n\r\nconst Lyric=computed(()=>{\r\n  let arr;\r\n   if(props.lyric.lyric){\r\n    arr=props.lyric.lyric.split(/[(\\r\\n)\\r\\n]+/).map((item,i)=>{\r\n      let min=item.slice(item.indexOf('[')+1,item.indexOf(':'))\r\n      let sec=item.slice(item.indexOf(':')+1,item.indexOf('.'))\r\n      let mill=item.slice(item.indexOf('.')+1,item.indexOf(']'))\r\n      let lrc=item.slice(item.indexOf(']')+1,item.length)\r\n      let time=parseInt(min)*60*1000+parseInt(sec)*1000+parseInt(mill)\r\n      return {min,sec,mill,lrc,time}\r\n    })\r\n   }\r\n   arr.forEach((item,i) => {\r\n    if(i===arr.length-1){\r\n      item.pre=0\r\n    }\r\n    else{\r\n      item.pre=arr[i+1].time\r\n    }\r\n   });\r\n   return arr;\r\n})\r\nconst musicLyric=ref()\r\nwatch(musicLyric,()=>{\r\n  console.log('22222');\r\n  let p=document.querySelector(\"p.active\")\r\n  console.log(p.offsetTop);//加括号看到引用\r\n  console.log(musicLyric)\r\n if(p&&p.offsetTop>600){\r\n  musicLyric._value.offsetTop=p.offsetTop-50\r\n }\r\n\r\n })\r\n</script>\r\n<style lang=\"less\" scoped>\r\n.bgimg{\r\n  height: 100%;\r\n  width: 100%;\r\n  position: absolute;\r\n  z-index: -1;\r\n  filter: blur(1.4rem);\r\n\r\n}\r\n.top{\r\n    height: 1rem;\r\n    width: 100%;\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    .topleft{\r\n        height: 100%;\r\n        width: 70%;\r\n        display: flex;\r\n        \r\n        align-items: center;\r\n        .name{\r\n          margin-left: 1rem;\r\n          \r\n          .b{\r\n            font-size: .1rem;\r\n            color: #999;\r\n            height: 40%;\r\n            display: flex;\r\n            justify-content: space-between;\r\n            align-items: center;\r\n            .icon{\r\n                height: .2rem;\r\n                width: 0.2rem;\r\n            }\r\n          }\r\n          .a{\r\n            font-size:.16rem;\r\n            \r\n          }\r\n        }\r\n    }\r\n    .topright{\r\n      margin-right: 0.4rem;\r\n    }\r\n}\r\n.content{\r\n  width: 100%;\r\n  height: 9rem;\r\n  display: flex;\r\n  flex-direction:column;\r\n  align-items: center;\r\n  position: relative;\r\n  .img_cizhen{\r\n    width: 2rem;\r\n    height: 3rem;\r\n    position: absolute;\r\n    left: 46%;\r\n    transform-origin: 0 0;\r\n    transform: rotate(-12deg);//转动度数\r\n    transition: all 1.5s;  //过度渐变属性\r\n    \r\n  }\r\n  .img_cizhen_active{\r\n    width: 2rem;\r\n    height: 3rem;\r\n    position: absolute;\r\n    left: 46%;\r\n    transform-origin: 0 0;\r\n    transform: rotate(0deg);//转动度数\r\n    transition: all 0.5s;\r\n     \r\n    \r\n  }\r\n  .img_cycle{ \r\n    width: 5rem;\r\n    height: 5rem;\r\n    position: absolute;\r\n    bottom: 2.3rem;\r\n    z-index: -1;\r\n  }\r\n  .pic{\r\n    width:3.2rem;\r\n    height: 3.2rem;\r\n    border-radius: 50%;\r\n    position: absolute;\r\n    bottom: 3.14rem;\r\n    animation: rotate_pic 10s linear infinite   ; //设置规则： 匀速 无限循环,简写\r\n   // animation-delay : 1.25s;延迟播放\r\n  }\r\n  //动画\r\n  .pic_active{\r\n    animation-play-state: running;\r\n  }\r\n  .pic_paused{\r\n    animation-play-state: paused;\r\n  }\r\n  @keyframes rotate_pic {//关键帧\r\n    0%{\r\n      transform: rotateZ(0deg);\r\n    }\r\n    100%{\r\n      transform: rotateZ(360deg);\r\n    }\r\n  }\r\n}\r\n.play{\r\n  height: 2rem;\r\n  width: 100%;\r\n  display: flex;\r\n  flex-direction:column;\r\n  align-items: center;\r\n  position: absolute;\r\n  bottom: 0px;\r\n   .icon{\r\n    fill: white;\r\n    height: 1rem;\r\n    width: 1rem;\r\n    position: absolute;\r\n    bottom: 1rem;\r\n   }\r\n}\r\n.lyric{\r\n   width: 100%;\r\n   height: 3rem;\r\n   display: flex;\r\n   flex-direction: column;\r\n   align-items: center;\r\n   overflow: scroll;//防溢出\r\n   scroll-behavior: smooth;\r\n   p{\r\n    color: rgb(201, 201, 201);\r\n    margin-bottom: 0.04rem;\r\n   \r\n    }\r\n    .active{\r\n      color :white;\r\n      font-size: 0.4rem;\r\n\r\n   }\r\n}\r\n</style>"]},"metadata":{},"sourceType":"module","externalDependencies":[]}