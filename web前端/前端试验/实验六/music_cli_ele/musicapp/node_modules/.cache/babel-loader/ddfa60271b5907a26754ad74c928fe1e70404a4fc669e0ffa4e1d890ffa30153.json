{"ast":null,"code":"import { getMusicaList } from \"@/request/API/home.js\";\nimport { reactive, onMounted } from \"vue\";\nexport default {\n  __name: 'MusicList',\n  setup(__props, {\n    expose\n  }) {\n    expose();\n    const state = reactive({\n      musicList: []\n    });\n    function changeCount(num) {\n      if (num >= 100000000) {\n        return (num / 100000000).toFixed(2) + '亿';\n      } else if (num >= 10000) return (num / 100000000).toFixed(2) + '万';\n    }\n    onMounted(async () => {\n      let res = await getMusicaList();\n      state.musicList = res.data.result;\n    });\n    const __returned__ = {\n      state,\n      changeCount,\n      get getMusicaList() {\n        return getMusicaList;\n      },\n      reactive,\n      onMounted\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"mappings":"AA0BA,SAAQA,aAAa,QAAM,uBAAuB;AAClD,SAASC,QAAQ,EAACC,SAAS,QAAQ,KAAK;;;;;;;IACxC,MAAMC,KAAK,GAACF,QAAQ,CAAC;MACjBG,SAAS,EAAC;IACd,CAAC,CAAC;IACF,SAASC,WAAW,CAACC,GAAG,EAAC;MACrB,IAAGA,GAAG,IAAE,SAAS,EAAC;QACd,OAAO,CAACA,GAAG,GAAC,SAAS,EAAEC,OAAO,CAAC,CAAC,CAAC,GAAC,GAAG;MACzC,CAAC,MACI,IAAGD,GAAG,IAAE,KAAK,EAClB,OAAO,CAACA,GAAG,GAAC,SAAS,EAAEC,OAAO,CAAC,CAAC,CAAC,GAAC,GAAG;IACzC;IACAL,SAAS,CAAC,YAAS;MACjB,IAAIM,GAAG,GAAC,MAAMR,aAAa,EAAE;MAC7BG,KAAK,CAACC,SAAS,GAACI,GAAG,CAACC,IAAI,CAACC,MAAM;IACjC,CAAC,CAAC","names":["getMusicaList","reactive","onMounted","state","musicList","changeCount","num","toFixed","res","data","result"],"sources":["D:/Users/fly/Vue/music_cli_ele/musicapp/src/components/home/MusicList.vue"],"sourcesContent":["<template>\r\n    <div class=\"musicList\">\r\n        <div class=\"musicTop\">\r\n            <div class=\"title\">发现好歌单</div>\r\n            <div class=\"more\">查看更多</div>\r\n        </div>\r\n    </div>\r\n    <div class=\"musicContent\">\r\n        <van-swipe :loop=\"false\" :width=\"150\" class=\"my-swipe\" :show-indicators=\"false\"><!--动态绑定-->\r\n         <van-swipe-item v-for=\"item in state.musicList\" :key=\"item.id\" class=\"oneSwipe\">\r\n        <img :src=\"item.picUrl\" />\r\n        <span class=\"playCount\">\r\n            <svg class=\"icon\" aria-hidden=\"true\">\r\n            <use xlink:href=\"#icon-24gl-play\"></use>\r\n            </svg>\r\n            <!--播放量-->\r\n            {{changeCount(item.playCount) }}\r\n        </span>\r\n        <!--图片下方字-->\r\n        <span class=\"name\">{{ item.name }}</span>\r\n        </van-swipe-item>\r\n        \r\n        </van-swipe>\r\n    </div>\r\n</template>\r\n<script setup>\r\nimport {getMusicaList}from \"@/request/API/home.js\"\r\nimport { reactive,onMounted } from \"vue\";\r\nconst state=reactive({\r\n    musicList:[],\r\n})\r\nfunction changeCount(num){\r\n    if(num>=100000000){\r\n        return (num/100000000).toFixed(2)+'亿'\r\n    }\r\n    else if(num>=10000)\r\n    return (num/100000000).toFixed(2)+'万'\r\n}\r\nonMounted(async()=>{\r\n  let res=await getMusicaList();\r\n  state.musicList=res.data.result;\r\n})\r\n</script>\r\n<!--lang=“less” 可以敲层级关系的样式\r\nscoped 使style内的样式只作用于当前的界面-->\r\n<style lang=\"less\" scoped>\r\n.musicList{\r\n    width: 100%;\r\n    height:1rem;\r\n    padding: 0.2rem;\r\n    .musicTop{\r\n        width:100%;\r\n        height: 0.6rem;\r\n        display: flex;\r\n        justify-content: space-between;\r\n        .title{\r\n            font-size: 0.4rem;\r\n            font-weight: 900;\r\n        }\r\n        .more{\r\n            border:1px solid #ccc;\r\n            text-align: center;\r\n            line-height:  0.6rem;\r\n            padding: 0 0.2rem;\r\n            border-radius: 0.4rem;//添加圆角边框\r\n        }\r\n    }\r\n\r\n\r\n}\r\n.musicContent{\r\n    width:100%;\r\n    height:4rem;\r\n    .my-swipe{\r\n    height: 100%;\r\n    padding-left:  .16rem;\r\n    .oneSwipe{\r\n      img{\r\n      width: 100%;\r\n      height: 3rem;\r\n      padding: .1rem;\r\n      border-radius: 0.3rem;//添加圆角边框\r\n      }\r\n      .playCount{\r\n       position: absolute;\r\n       top: .2rem;\r\n       right: .2rem;\r\n       border:1px solid rgb(204, 204, 204);\r\n       background-color:darkgray;\r\n       border-radius: 0.5rem;\r\n       text-align: center;\r\n       display: flex;\r\n       justify-content:center ;\r\n           .icon{\r\n           margin: 2px;\r\n           height: .3rem;\r\n           width: .3rem;\r\n           }\r\n       }\r\n   \r\n     }\r\n    }\r\n}\r\n\r\n</style>"]},"metadata":{},"sourceType":"module","externalDependencies":[]}