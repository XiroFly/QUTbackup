<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="dao.GoodsDao">
    <select id="getGoodsByPage" resultType="bean.vo.GoodsVo">
        select * from goods limit #{beginIndex}, #{pageSize}
    </select>
    <select id="getGoodsById" resultType="bean.vo.GoodsVo">
        select * from goods where goodsid = #{goodsId}
    </select>
    <select id="getPageCount" resultType="Integer">
        select count(*) from goods
    </select>
    <insert id="saveGoods" >
        insert into goods(goodsid, goodsname, price) values(null, #{goodsName}, #{price})
    </insert>
<!--    <insert id="saveGoods" >-->
<!--        insert into goods(goodsid, goodsname, price) values(#{goodsId}, #{goodsName}, #{price})-->
<!--    </insert>-->
    <update id="modifyGoods">
        update goods set goodsname = #{goodsName}, price = #{price} where goodsid = #{goodsId}
    </update>
    <delete id="deleteGoods">
        delete from goods where goodsid = #{goodsId}
    </delete>
</mapper>