		end.tRanslation(x2, y2);
	}
	void translation(int changeX,int changeY) {
	start.tRanslation(changeX, changeY);
	end.tRanslation(changeX, changeY);
}
	double length() {
		double d=start.distance(end.x,end.y );
		System.out.println("长度："+d);
		return d;
	}
}
class Polyline{
	Line sum[];
	Polyline(Point ...p) {
		sum=new Line[p.length-1];
		for(int i=0;i<sum.length;i++) {
			sum[i].start=p[i];
			sum[i].end=p[i+1];
	}
		}
	void Polylength() {
		double length=0;
		for(int i=0;i<sum.length;i++) {
			length+=sum[i].length();
		}
		System.out.println("折线长度："+length);
	}
	
}
