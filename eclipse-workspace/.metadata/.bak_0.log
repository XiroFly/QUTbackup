		x=x+changeX;
		y=y+changeY;
	}
	void printf() {
		System.out.println("坐标为:"+x+" "+y);
	}
	double distance(int x1,int y1) {
		double d;
		d=Math.pow((x-x1)*(x-x1)+(y-y1)*(y-y1), 1/2);
		System.out.println(d);
		return d;
	}
	
