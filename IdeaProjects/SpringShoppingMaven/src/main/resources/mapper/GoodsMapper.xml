<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mapper.GoodsMapper">
    <resultMap id="map" type="bean.vo.GoodsVo" >
        <result column="goodsid" property="goodsId"/>
        <result column="goodsname" property="goodsName"/>
        <result column="price" property="price"/>
    </resultMap>
    <insert id="saveGoods" useGeneratedKeys="true" keyProperty="id" >
     insert into goods(goodsname,price)
     values (#{goodsName},#{price})
    </insert>
     <update id="modifyGoods">
        update goods set goodsname= #{goodsName},
                         price=#{price}
        where goodsid=#{goodsId}
    </update>
    <delete id="deleteGoods">
        delete from goods where id=#{goodsId}
    </delete>
    <select id="getGoodsByPage" resultMap="map">
        select * from goods limit #{size} offset #{begin}
    </select>
    <select id="getGoodsById" resultMap="map">
        select * from goods  where goodsid= #{goodsId}
    </select>
    <select id="getPageCount" resultType="java.lang.Integer">
        select count(*) from goods
    </select>
</mapper>
