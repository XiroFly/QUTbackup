<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- com.dao.AdminDao对应Dao接口 -->
<mapper namespace="com.dao.admin.AdminGoodsDao">
    <select id="findGoodsByPage" resultType="goods" parameterType="map">
        SELECT * FROM goodstable limit #{begin},#{pageSize}
    </select>
    <select id="findGoodsCount" resultType="Integer">
        SELECT COUNT(*) FROM goodstable
    </select>
</mapper>